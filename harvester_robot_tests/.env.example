# Harvester Robot Framework Test Configuration
# Copy this file to .env and update with your values
# Usage: source .env && ./run.sh

# ============================================
# Harvester Cluster Configuration
# ============================================
# Harvester API endpoint (with https://)
HARVESTER_ENDPOINT=https://localhost:30443

# Harvester admin credentials
HARVESTER_USERNAME=admin
HARVESTER_PASSWORD=<your_password_here>


# ============================================
# Rancher
# ============================================
RANCHER_ENDPOINT=
RANCHER_USERNAME=
RANCHER_PASSWORD=


# ============================================
# Rancher AI
# ============================================
# Model: Try Ollama first. If it isn't configured, try Gemini next.
OLLAMA_URL=
OLLAMA_MODEL=muse-glimmer:30b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Rancher AI
RANCHER_AI_VERIFY_TLS=false
# RANCHER_AI_CA_BUNDLE=/path/to/rancher-ca.pem
RANCHER_AI_CONNECT_TIMEOUT=30
RANCHER_AI_TIMEOUT=120
RANCHER_AI_MAX_RESPONSE_BYTES=2097152
# DeepEval
AI_EVAL_THRESHOLD=0.8
AI_EVAL_TIMEOUT=120

# SSH private key (PEM format) used to access the Harvester host node
# (e.g. as a jump host to reach VM guests). Keep the line breaks, e.g.:
# SSH_PRIVATE_KEY="-----BEGIN OPENSSH PRIVATE KEY-----
# ...
# -----END OPENSSH PRIVATE KEY-----"
SSH_PRIVATE_KEY=

# ============================================
# Network Configuration
# ============================================
# VLAN configuration for network tests
VLAN_ID=1
VLAN_NIC=mgmt

# ============================================
# Backup Configuration
# ============================================
# NFS endpoint used to configure the cluster backup-target setting when it is
# not set yet (backup suites skip when neither is available)
# BACKUP_TARGET_NFS_ENDPOINT=nfs://192.168.1.100/backupstore

# LVM addon manifest. Leave unset to derive the branch from the cluster release
# (v<major>.<minor>; dev builds use master): harvester/harvester
# addons/standalone since v1.9, harvester/experimental-addons before that.
# Set it to a mirror in air-gapped setups.
# LVM_ADDON_URL=https://raw.githubusercontent.com/harvester/harvester/v1.9/addons/standalone/harvester-csi-driver-lvm/addon.yaml

# ============================================
# Test Execution Settings
# ============================================
# Log level: TRACE, DEBUG, INFO, WARN, ERROR
ROBOT_LOG_LEVEL=INFO

# Parallel execution (number of parallel test workers)
ROBOT_PARALLEL_WORKERS=1

# Test tags to include/exclude (comma-separated)
# Examples: coretest, p0, p1, regression
ROBOT_INCLUDE_TAGS=
ROBOT_EXCLUDE_TAGS=

# Specific test suite to run (leave empty to run all)
# Examples: tests/regression/test_vm.robot
ROBOT_TEST_SUITE=

# Output directory for test results
ROBOT_OUTPUT_DIR=./results

# ============================================
# Kubernetes Configuration
# ============================================
# Path to kubeconfig file (optional, defaults to ~/.kube/config)
# KUBECONFIG=/path/to/your/kubeconfig

# ============================================
# Optional: Advanced Settings
# ============================================
# Custom Python path for additional libraries
# PYTHONPATH=/path/to/custom/libs:$PYTHONPATH

# Disable SSL warnings (set to 1 to disable)
PYTHONWARNINGS="ignore:Unverified HTTPS request"

# Robot Framework variables (alternative to environment variables)
# ROBOT_VARIABLES=HARVESTER_ENDPOINT:https://example.com,WAIT_TIMEOUT:900
